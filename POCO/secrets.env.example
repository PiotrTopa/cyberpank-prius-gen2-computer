# POCO F1 provisioning secrets — TEMPLATE.
# Copy to `secrets.env` (gitignored) and fill in the real values.
# sync.sh sources this file and renders the *.nmconnection.tmpl files with envsubst.
#
# Recover current values from the phone (over VPN) with:
#   ssh user@10.200.0.5 'sudo grep -h . \
#     /etc/NetworkManager/system-connections/wg-homelab.nmconnection \
#     /etc/NetworkManager/system-connections/prius-wan.nmconnection \
#     /etc/NetworkManager/system-connections/prius-home-wifi.nmconnection \
#     /etc/NetworkManager/system-connections/prius-ap.nmconnection'

# WireGuard tunnel (phone side)
WG_PRIVATE_KEY=PUT-WIREGUARD-PRIVATE-KEY-HERE
WG_PEER_PUBLIC_KEY=PUT-WG-SERVER-PUBLIC-KEY-HERE

# SIM
SIM_PIN=0000

# Wi-Fi PSKs
HOME_WIFI_PSK=PUT-HOME-WIFI-PSK-HERE
AP_PSK=PUT-AP-PSK-HERE
DEV_WIFI_PSK=PUT-DEV-WIFI-PSK-HERE
