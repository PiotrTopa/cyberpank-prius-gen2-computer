#!/bin/sh
# prius-wifi - toggle wlan0 between home-wifi client, prius AP, or off.
# Invariants: NEVER touch the SIM WAN (prius-wan) or WireGuard (wg-homelab);
# those stay up so SSH-over-cellular + VPN always survive a wifi switch.
# Modes (flag /etc/prius/wifi-mode): client | ap | off
# Lifeline (prius-lifeline, uplink down): `suspend` is a no-op, `off` keeps the
# AP, and `lifeline` brings the AP up without rewriting the flag.
# The power profile (prius-power) does NOT rewrite the flag: `suspend` turns the
# radio off for the key-off `low` profile, `resume` re-applies the flag for
# `full`. Every verb is idempotent (an already-active mode is left alone) and
# the whole script runs under one lock, because prius-wifi.path re-runs
# `prius-wifi apply` on every flag write — two concurrent activations of the
# AP used to race ("base network connection was interrupted", 2026-11-04).
set -eu
FLAG=${PRIUS_WIFI_FLAG:-/etc/prius/wifi-mode}   # env overrides: tests only
CLIENT_CON=prius-home-wifi
AP_CON=prius-ap
LOCK=${PRIUS_WIFI_LOCK:-/run/lock/prius-wifi.lock}
# prius-lifeline marker: uplink (LTE/WireGuard) is down, the car AP must stay up.
LIFELINE=${LIFELINE_RUN:-/run/prius-lifeline}/active
lifeline_on() { [ -e "$LIFELINE" ]; }

read_flag() { [ -r "$FLAG" ] && tr -d ' \t\n' < "$FLAG" || echo off; }
active_wifi() {
  nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1}' | head -1
}

set_client() {
  [ "$(active_wifi)" = "$CLIENT_CON" ] && return 0
  nmcli radio wifi on
  nmcli con down "$AP_CON" >/dev/null 2>&1 || true
  nmcli con up "$CLIENT_CON"
}
set_ap() {
  [ "$(active_wifi)" = "$AP_CON" ] && return 0
  nmcli radio wifi on
  nmcli con down "$CLIENT_CON" >/dev/null 2>&1 || true
  sleep 2
  nmcli con up "$AP_CON"
}
set_off() {
  if [ -z "$(active_wifi)" ] && [ "$(nmcli radio wifi 2>/dev/null)" = "disabled" ]; then return 0; fi
  nmcli con down "$CLIENT_CON" >/dev/null 2>&1 || true
  nmcli con down "$AP_CON" >/dev/null 2>&1 || true
  nmcli radio wifi off
}

apply() {
  case "$(read_flag)" in
    client) set_client ;;
    ap)     set_ap ;;
    off|*)
      if lifeline_on; then
        echo "prius-wifi: flag off, but the lifeline is ON (uplink down): keeping the AP" >&2
        set_ap
      else
        set_off
      fi ;;
  esac
}

status() {
  echo "wifi-mode flag : $(read_flag)"
  echo "lifeline       : $(lifeline_on && echo 'ON (uplink down: AP kept up, suspend blocked)' || echo off)"
  echo "radio          : $(nmcli radio wifi 2>/dev/null)"
  echo "wlan0          : $(nmcli -t -f GENERAL.STATE dev show wlan0 2>/dev/null | cut -d: -f2)"
  echo "wlan0 ip       : $(nmcli -t -f IP4.ADDRESS dev show wlan0 2>/dev/null | cut -d: -f2 | head -1)"
  echo "active wifi con: $(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1}' | tr '\n' ' ')"
  echo "WAN/VPN intact : $(nmcli -t -f NAME con show --active 2>/dev/null | grep -E 'prius-wan|wg-homelab' | tr '\n' ' ')"
  echo "default routes :"
  ip route show default | sed 's/^/  /'
}

# Only touch the flag when it changes (every write re-triggers prius-wifi.path).
write_flag() { [ "$(read_flag)" = "$1" ] && return 0; echo "$1" | tee "$FLAG" >/dev/null; }

verb="${1:-status}"
case "$verb" in
  status) status; exit 0 ;;
  client|ap|off|apply|suspend|resume|lifeline) ;;
  *) echo "usage: prius-wifi {client|ap|off|apply|suspend|resume|lifeline|status}" >&2; exit 2 ;;
esac

# Serialise with the path-unit re-run (and with prius-power).
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK"
  flock -w 60 9 || echo "prius-wifi: lock busy, continuing" >&2
fi

case "$verb" in
  client) write_flag client; apply ;;
  ap)     write_flag ap;     apply ;;
  off)    write_flag off;    apply ;;
  apply|resume) apply ;;        # resume: power profile 'full' -> whatever the flag says
  suspend)                      # power profile 'low': radio off, flag untouched
    if lifeline_on; then
      echo "prius-wifi: suspend skipped: lifeline ON (uplink down), the AP stays up"
    else
      set_off
    fi ;;
  lifeline) set_ap ;;           # prius-lifeline: AP up, flag untouched
esac
