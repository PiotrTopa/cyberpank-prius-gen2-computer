#!/bin/sh
# prius-flash-powerbox - update the powerbox firmware over its NDJSON link.
#
# Needs firmware >= 2.2.0 on the board (put_begin/put/put_end/reboot). No REPL,
# no Ctrl-C: the firmware keeps running, so the POCO button stays released and
# the WDT fed while the files are streamed, verified (size + sha256) and swapped
# in (old copy kept as <name>.bak; boot.py restores it after an interrupted
# swap). pb_flash.py sends the host heartbeat itself, so the wake ladder stays
# quiet while prius-backend is stopped.
#
# Usage:
#   sudo prius-flash-powerbox                 # main.py + boot.py + bean_rx.py from $DIR
#   sudo prius-flash-powerbox FILE [FILE ...] # e.g. .../pcf8574.py
#
# Env: PRIUS_POWERBOX_DIR (default /home/user/cyberpunk/powerbox, filled by
#      `sync.sh --app`), PRIUS_POWERBOX_BYID.
set -eu

DIR="${PRIUS_POWERBOX_DIR:-/home/user/cyberpunk/powerbox}"
BYID="${PRIUS_POWERBOX_BYID:-/dev/serial/by-id/usb-MicroPython_Board_in_FS_mode_503359277a7c699f-if00}"

# bean_rx.py (fw >= 2.3.0): pb_flash sends main.py first and, if the running
# firmware (< 2.3.0) refuses the new file name, reboots once and retries.
[ "$#" -gt 0 ] || set -- "$DIR/main.py" "$DIR/boot.py" "$DIR/bean_rx.py"
[ -e "$BYID" ] || { echo "flash: powerbox not present at $BYID" >&2; exit 1; }

restart() { systemctl start prius-backend.service || true; }
systemctl stop prius-backend.service
trap restart EXIT
python3 "$DIR/pb_flash.py" --port "$BYID" "$@"
