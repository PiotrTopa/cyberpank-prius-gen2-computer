#!/bin/sh
# prius-dtb-patch - the car computer's device-tree patch as one reproducible step.
#
# The POCO F1 car computer boots the stock postmarketOS kernel with the Tianma DTB
# (/boot/dtbs/qcom/sdm845-xiaomi-beryllium-tianma.dtb, owned by the kernel package)
# plus three owner edits. Without them the phone boots in USB device mode with no
# VBUS: no hub, powerbox, gateway, panda or MFD link.
#
#   P1  usb@a600000 dr_mode "peripheral" -> "host"         (USB host role)
#   P2  pmic@2 gets usb-vbus-regulator@1100                (PMI8998 OTG boost = VBUS,
#       qcom,pm8150b-vbus-reg, always-on; see pmi8998-usb-vbus.dtso)
#   P3  i2c@a98000 touchscreen@1 novatek,nt36672a-ts -> touchscreen@38 focaltech,ft8719
#       (replacement panel; harmless headless, kept so the DTB matches the running one)
#
# Usage:
#   prius-dtb-patch apply IN.dtb OUT.dtb   write the patched DTB (IN may equal OUT);
#                                          idempotent: a patched IN gives the same OUT
#   prius-dtb-patch check DTB              exit 0 if DTB carries P1+P2+P3, else 1
#   prius-dtb-patch check-live             same for the running kernel's device tree
#   prius-dtb-patch check-bootimg IMG      same for the DTB appended to the kernel inside
#                                          a boot.img or the boot partition (= next boot)
#
# Reference: pristine DTB of linux-postmarketos-qcom-sdm845-7.1_rc1-r4
#   sha256 44f744d18ca05ea29c13352a12db8266b1b7780b11299a1b1dd26726a229c0d2
# patched by this script ->
#   sha256 6164722f5a0d74ad94c2eb34960af48b07ca5eb76dffa4d24822b0e2f4f60710
# which is byte-identical to the DTB running since 2026-10-22 (see
# docs/POCO_REBUILD.md). The sorted-DTS diff is POCO/dts/tianma-prius.dts.diff.
#
# Needs dtc/fdtget/fdtput (apk dtc). Fails closed: any unexpected input -> exit 1
# and OUT is not written.
set -eu

USB_NODE=/soc@0/usb@a6f8800/usb@a600000
PMIC_NODE=/soc@0/spmi@c440000/pmic@2
VBUS=usb-vbus-regulator@1100
I2C_NODE=/soc@0/geniqup@ac0000/i2c@a98000

die() { echo "prius-dtb-patch: ERROR: $*" >&2; exit 1; }

check_dtb() { # $1 dtb ; prints a line per patch, returns 0 only if all present
    d=$1; ok=0
    m=$(fdtget "$d" "$USB_NODE" dr_mode 2>/dev/null || echo missing)
    if [ "$m" = host ]; then echo "P1 dr_mode=host ok"; else echo "P1 dr_mode=$m MISSING"; ok=1; fi
    c=$(fdtget "$d" "$PMIC_NODE/$VBUS" compatible 2>/dev/null || echo missing)
    if [ "$c" = "qcom,pm8150b-vbus-reg" ]; then echo "P2 $VBUS ok"; else echo "P2 $VBUS MISSING"; ok=1; fi
    t=$(fdtget "$d" "$I2C_NODE/touchscreen@38" compatible 2>/dev/null || echo missing)
    if [ "$t" = "focaltech,ft8719" ]; then echo "P3 touchscreen@38 ft8719 ok"; else echo "P3 touch MISSING"; ok=1; fi
    return $ok
}

check_live() {
    b=/sys/firmware/devicetree/base; ok=0
    m=$(tr -d '\0' < "$b$USB_NODE/dr_mode" 2>/dev/null || echo missing)
    if [ "$m" = host ]; then echo "P1 live dr_mode=host ok"; else echo "P1 live dr_mode=$m MISSING"; ok=1; fi
    c=$(tr -d '\0' < "$b$PMIC_NODE/$VBUS/compatible" 2>/dev/null || echo missing)
    if [ "$c" = "qcom,pm8150b-vbus-reg" ]; then echo "P2 live $VBUS ok"; else echo "P2 live $VBUS MISSING"; ok=1; fi
    t=$(tr -d '\0' < "$b$I2C_NODE/touchscreen@38/compatible" 2>/dev/null || echo missing)
    if [ "$t" = "focaltech,ft8719" ]; then echo "P3 live touchscreen@38 ok"; else echo "P3 live touch MISSING"; ok=1; fi
    return $ok
}

check_bootimg() { # $1 boot.img file or boot partition: check the DTB appended to its kernel
    src=$1; tmpd=$(mktemp -d /tmp/prius-dtbimg.XXXXXX)
    python3 - "$src" "$tmpd/appended.dtb" <<'PY' || { rm -rf "$tmpd"; echo "P0 no appended DTB found in $src"; return 1; }
import struct, sys
src, out = sys.argv[1], sys.argv[2]
with open(src, 'rb') as f:
    hdr = f.read(48)
    if hdr[:8] != b'ANDROID!':
        sys.exit("not an Android boot image")
    ksize, = struct.unpack_from('<I', hdr, 8)
    page, = struct.unpack_from('<I', hdr, 36)
    f.seek(page)
    kern = f.read(ksize)
# the appended DTB ends exactly at the end of the kernel payload
i = len(kern)
while True:
    i = kern.rfind(b'\xd0\x0d\xfe\xed', 0, i)
    if i < 0:
        sys.exit("no DTB magic")
    tot, = struct.unpack_from('>I', kern, i + 4)
    if i + tot == len(kern):
        open(out, 'wb').write(kern[i:])
        break
PY
    echo "boot image $src: appended DTB sha256 $(sha256sum "$tmpd/appended.dtb" | cut -c1-16)..."
    r=0; check_dtb "$tmpd/appended.dtb" || r=1
    rm -rf "$tmpd"; return $r
}

apply() { # $1 in $2 out
    in=$1; out=$2
    [ -f "$in" ] || die "no such DTB: $in"
    for t in dtc fdtget fdtput; do command -v $t >/dev/null 2>&1 || die "$t missing (apk dtc)"; done
    fdtget "$in" / compatible 2>/dev/null | grep -q "xiaomi,beryllium" || die "$in is not a beryllium DTB"
    if check_dtb "$in" >/dev/null; then
        # already patched: leave the bytes alone (a recompile would reorder them)
        [ "$in" -ef "$out" ] || { cp "$in" "$out.prius-tmp" && mv "$out.prius-tmp" "$out"; }
        echo "prius-dtb-patch: $in already patched, unchanged"
        return 0
    fi
    tmp=$(mktemp -d /tmp/prius-dtb.XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    dtc -q -I dtb -O dts -o "$tmp/in.dts" "$in" || die "decompile failed"

    # P3: touch node (text edit inside the i2c@a98000 block only)
    if fdtget "$in" "$I2C_NODE/touchscreen@38" compatible >/dev/null 2>&1; then
        cp "$tmp/in.dts" "$tmp/t.dts"
    else
        fdtget "$in" "$I2C_NODE/touchscreen@1" compatible 2>/dev/null | grep -q "novatek,nt36672a-ts" \
            || die "touch anchor $I2C_NODE/touchscreen@1 (novatek) not found"
        awk '
        /^\t\t\ti2c@a98000 \{/ { ini2c=1 }
        ini2c && /^\t\t\t\};/ { ini2c=0 }
        ini2c && /^\t\t\t\ttouchscreen@1 \{/ { sub(/touchscreen@1 \{/, "touchscreen@38 {"); intouch=1; n++ }
        intouch && /compatible = "novatek,nt36672a-ts";/ { sub(/"novatek,nt36672a-ts"/, "\"focaltech,ft8719\""); c++ }
        intouch && /^\t\t\t\t\treg = <0x01>;/ { sub(/<0x01>/, "<0x38>"); r++ }
        intouch && /^\t\t\t\t\};/ { intouch=0 }
        { print }
        END { if (n != 1 || c != 1 || r != 1) exit 3 }
        ' "$tmp/in.dts" > "$tmp/t.dts" || die "touch edit did not match exactly once"
    fi

    # P2: VBUS regulator node inside pmic@2, before charger@1000
    if fdtget "$in" "$PMIC_NODE/$VBUS" compatible >/dev/null 2>&1; then
        cp "$tmp/t.dts" "$tmp/v.dts"
    else
        fdtget -l "$in" "$PMIC_NODE" 2>/dev/null | grep -qx "charger@1000" || die "anchor $PMIC_NODE/charger@1000 not found"
        awk '
        /^\t\t\tpmic@2 \{/ { inpmic=1 }
        inpmic && /^\t\t\t\};/ { inpmic=0 }
        inpmic && /^\t\t\t\tcharger@1000 \{/ && !done {
          print "\t\t\t\tusb_vbus: usb-vbus-regulator@1100 {";
          print "\t\t\t\t\tcompatible = \"qcom,pm8150b-vbus-reg\";";
          print "\t\t\t\t\treg = <0x1100>;";
          print "\t\t\t\t\tregulator-min-microamp = <500000>;";
          print "\t\t\t\t\tregulator-max-microamp = <3000000>;";
          print "\t\t\t\t\tregulator-always-on;";
          print "\t\t\t\t\tregulator-boot-on;";
          print "\t\t\t\t};";
          print "";
          done=1 }
        { print }
        END { if (!done) exit 3 }
        ' "$tmp/t.dts" > "$tmp/v.dts" || die "VBUS insert anchor not matched"
    fi

    dtc -q -I dts -O dtb -o "$tmp/out.dtb" "$tmp/v.dts" || die "recompile failed"
    # P1: dr_mode (fdtput, as poco-usb/prius-usb did)
    fdtget "$tmp/out.dtb" "$USB_NODE" dr_mode >/dev/null 2>&1 || die "node $USB_NODE not found"
    fdtput -t s "$tmp/out.dtb" "$USB_NODE" dr_mode host || die "fdtput dr_mode failed"
    check_dtb "$tmp/out.dtb" >/dev/null || { check_dtb "$tmp/out.dtb" >&2; die "patched DTB fails its own check"; }
    cp "$tmp/out.dtb" "$out.prius-tmp" && mv "$out.prius-tmp" "$out"
    echo "prius-dtb-patch: wrote $out ($(sha256sum "$out" | cut -c1-16)...)"
}

case "${1:-}" in
    apply) [ $# -eq 3 ] || die "usage: apply IN.dtb OUT.dtb"; apply "$2" "$3" ;;
    check) [ $# -eq 2 ] || die "usage: check DTB"; check_dtb "$2" ;;
    check-live) check_live ;;
    check-bootimg) [ $# -eq 2 ] || die "usage: check-bootimg IMG|PARTITION"; check_bootimg "$2" ;;
    *) echo "usage: prius-dtb-patch {apply IN OUT|check DTB|check-live|check-bootimg IMG}" >&2; exit 2 ;;
esac
