#!/bin/sh
# prius-power - Prius computer power profiles. Never suspends the system:
# keeps modem (cellular), WireGuard, SSH and USB/OTG serial listening alive.
#   low  : key OFF  - offline Gold cluster, cap Silver cluster (lowest idle draw);
#                     Wi-Fi stays up for a grace period (/etc/prius/wifi-grace, default
#                     20min) and is then suspended by a transient timer
#                     (prius-wifi-suspend.timer -> prius-wifi suspend; wifi-mode flag kept)
#   full : key ON   - all cores online, full clocks, the pending Wi-Fi suspend is
#                     cancelled and Wi-Fi comes back per /etc/prius/wifi-mode
# The backend writes /etc/prius/power-mode at key-off (deferred until the
# roadsense stack is down, since it pins cpu4-7) and at key-on; prius-power.path
# then runs `prius-power apply`.
set -u

FLAG=/etc/prius/power-mode
CPU=/sys/devices/system/cpu
LITTLE_MAX_LOW=1228800     # cap Silver cluster (~1.2 GHz) in low mode
BIG_CORES="4 5 6 7"        # Gold cluster, offlined in low mode
WIFI_GRACE_FILE=/etc/prius/wifi-grace   # systemd time span, e.g. 20min, 0 = immediate
WIFI_SUSPEND_UNIT=prius-wifi-suspend    # transient timer/service pair (systemd-run)

wifi_grace() { tr -d ' \n' < "$WIFI_GRACE_FILE" 2>/dev/null || true; }

# Cancel a pending Wi-Fi suspend (stopping a transient timer removes it).
wifi_suspend_cancel() {
    systemctl stop "$WIFI_SUSPEND_UNIT.timer" "$WIFI_SUSPEND_UNIT.service" >/dev/null 2>&1 || true
}

# Suspend Wi-Fi after the grace period; every call re-arms the full period.
wifi_suspend_later() {
    g=$(wifi_grace); [ -n "$g" ] || g=20min
    wifi_suspend_cancel
    if [ "$g" = 0 ] || [ "$g" = 0s ]; then
        /usr/local/sbin/prius-wifi suspend; return
    fi
    if ! systemd-run --quiet --collect --unit="$WIFI_SUSPEND_UNIT" --on-active="$g" \
            --timer-property=AccuracySec=15s --description="Prius Wi-Fi suspend after key-off grace ($g)" \
            /usr/local/sbin/prius-wifi suspend; then
        echo "prius-power: could not arm the Wi-Fi grace timer, suspending now" >&2
        /usr/local/sbin/prius-wifi suspend
    fi
}

set_gov() {
    [ -w "$1/scaling_governor" ] && echo "$2" > "$1/scaling_governor" 2>/dev/null || true
}

# Blank the unused DSI display pipeline (saves ~0.19 W at idle) — OPT-IN only,
# via the flag /etc/prius/blank-display. Off by default since 2026-11-04: on
# the single computer (kernel 7.1) blanking leaves the LAB/IBB over-current IRQ
# storming (~4600/s) and unbinding labibb takes the GPU (roadsense) down; the
# blanked panel is also the suspect for `systemctl reboot` hangs.
display_off() {
    [ -e /etc/prius/blank-display ] || return 0
    command -v systemctl >/dev/null 2>&1 && \
        systemctl start prius-blank.service >/dev/null 2>&1 || true
}
display_on() {
    # DISABLED as a runtime path: restoring the panel after the labibb unbind
    # (see prius-blankd / POWER.md "LAB over-current IRQ storm") hard-hangs
    # the kernel. Reboot without prius-blank running to get the display back.
    echo "display restore requires a reboot (see POWER.md: LAB IRQ storm)" >&2
}

apply_low() {
    for p in "$CPU"/cpufreq/policy*; do
        [ -d "$p" ] && set_gov "$p" schedutil
    done
    [ -w "$CPU/cpufreq/policy0/scaling_max_freq" ] && \
        echo "$LITTLE_MAX_LOW" > "$CPU/cpufreq/policy0/scaling_max_freq" 2>/dev/null || true
    for n in $BIG_CORES; do
        [ -w "$CPU/cpu$n/online" ] && echo 0 > "$CPU/cpu$n/online" 2>/dev/null || true
    done
    wifi_suspend_later
    display_off
}

apply_full() {
    # The DSI display/graphics output is never used on this box (GPU compute is
    # still available -- blanking is a DRM modeset-off of the display controller,
    # not the Adreno GPU). So keep the panel blanked in full mode too; only the
    # CPU/wifi profile differs from low.
    display_off
    for n in $BIG_CORES; do
        [ -w "$CPU/cpu$n/online" ] && echo 1 > "$CPU/cpu$n/online" 2>/dev/null || true
    done
    wifi_suspend_cancel
    /usr/local/sbin/prius-wifi resume
    for p in "$CPU"/cpufreq/policy*; do
        [ -d "$p" ] || continue
        set_gov "$p" schedutil
        if [ -r "$p/cpuinfo_max_freq" ] && [ -w "$p/scaling_max_freq" ]; then
            cat "$p/cpuinfo_max_freq" > "$p/scaling_max_freq" 2>/dev/null || true
        fi
    done
}

status() {
    echo "mode-flag : $(cat "$FLAG" 2>/dev/null || echo '?')"
    echo "cpus online: $(cat "$CPU/online")"
    for p in "$CPU"/cpufreq/policy*; do
        [ -d "$p" ] || continue
        echo "  $(basename "$p"): gov=$(cat "$p/scaling_governor" 2>/dev/null) cur=$(cat "$p/scaling_cur_freq" 2>/dev/null) max=$(cat "$p/scaling_max_freq" 2>/dev/null)"
    done
    g=/sys/class/devfreq/5000000.gpu
    [ -d "$g" ] && echo "  gpu: cur=$(cat "$g/cur_freq" 2>/dev/null) gov=$(cat "$g/governor" 2>/dev/null)"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl is-active --quiet prius-blank.service 2>/dev/null && ds=blanked || ds=on
        echo "  display : $ds"
    fi
    if systemctl is-active --quiet "$WIFI_SUSPEND_UNIT.timer" 2>/dev/null; then
        echo "  wifi    : suspend pending ($(systemctl show -p NextElapseUSecRealtime --value "$WIFI_SUSPEND_UNIT.timer" 2>/dev/null)), grace $(wifi_grace)"
    fi
}

mode="${1:-apply}"
case "$mode" in
    low|full)
        echo "$mode" > "$FLAG"
        [ "$mode" = low ] && apply_low || apply_full
        ;;
    apply)
        m=$(cat "$FLAG" 2>/dev/null || echo full)
        [ "$m" = low ] && apply_low || apply_full
        ;;
    status) status; exit 0 ;;
    *) echo "usage: prius-power {low|full|apply|status}" >&2; exit 2 ;;
esac
status
