#!/bin/sh
# prius-deploy-mfd — push the MFD frontend code from the POCO to the Pi over
# the USB gadget network (usb0, 192.168.100.2) and restart mfd.service.
#
# The POCO's $BACKEND_REPO/cyberpunk_computer/ is the staging copy
# (rsynced there from the workstation over the VPN); the Pi runs the same
# package via `python -m cyberpunk_computer.frontend` (unit: mfd.service,
# venv: ~/cyberpunk_computer/.venv — remember new deps go into THAT venv).
#
# Run as root (root holds the key authorized on the Pi):
#   sudo prius-deploy-mfd            # sync + restart
#   sudo prius-deploy-mfd --dry-run  # show what would change
#
# Requires the Pi to be powered (MFD manager, or manual `set_relay ch3 on`
# when BACKEND_MFD_ENABLED=0) and its gadget up (host side 192.168.100.1 —
# the backend's MFD manager configures it; manually:
#   ip addr add 192.168.100.1/24 dev usb0; ip link set usb0 up).
set -eu

PI="piotr@192.168.100.2"
# Staging copy = the backend's own checkout (BACKEND_REPO in backend.env;
# /home/user/cyberpunk on the single car computer).
BACKEND_REPO=/home/user/cyberpunk
[ -r /etc/prius/backend.env ] && BACKEND_REPO=$(sed -n 's/^BACKEND_REPO=//p' /etc/prius/backend.env | tail -1)
SRC="${BACKEND_REPO:-/home/user/cyberpunk}/cyberpunk_computer/"
DST="cyberpunk_computer/cyberpunk_computer/"
SSH="ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=5"
DRY=""
[ "${1:-}" = "--dry-run" ] && DRY="--dry-run -v"

[ -d "$SRC" ] || { echo "prius-deploy-mfd: source $SRC missing" >&2; exit 1; }
$SSH "$PI" true || { echo "prius-deploy-mfd: Pi unreachable at 192.168.100.2 (powered? gadget up?)" >&2; exit 1; }

# shellcheck disable=SC2086
rsync -az --delete --exclude __pycache__ $DRY -e "$SSH" "$SRC" "$PI:$DST"
[ -n "$DRY" ] && { echo "(dry run - nothing restarted)"; exit 0; }

# Wall clock: the Pi has no RTC and no internet. systemd-timesyncd syncs from
# the backend's SNTP server on the gadget link (cyberpunk_computer/backend/
# ntp_server.py) and saves the time every 60 s, so a cold boot without the
# phone starts at the last saved time instead of a weeks-old one. Idempotent.
$SSH "$PI" 'sudo sh -s' <<'TIMECONF' || echo "prius-deploy-mfd: WARNING: Pi time config failed" >&2
set -e
mkdir -p /etc/systemd/timesyncd.conf.d
cat > /tmp/prius-time.conf <<'X'
# installed by prius-deploy-mfd (POCO): time from the phone over usb0
[Time]
NTP=192.168.100.1
FallbackNTP=
PollIntervalMinSec=32
PollIntervalMaxSec=1024
SaveIntervalSec=60
X
changed=0
if ! cmp -s /tmp/prius-time.conf /etc/systemd/timesyncd.conf.d/prius.conf; then
    mv /tmp/prius-time.conf /etc/systemd/timesyncd.conf.d/prius.conf
    changed=1
fi
rm -f /tmp/prius-time.conf
if ! systemctl is-enabled --quiet systemd-timesyncd; then
    systemctl enable systemd-timesyncd
    changed=1
fi
if [ "$changed" = 1 ] || ! systemctl is-active --quiet systemd-timesyncd; then
    systemctl restart systemd-timesyncd
fi
TIMECONF

$SSH "$PI" "sudo systemctl restart mfd.service"
echo "deployed; mfd.service restarted. Proof-of-life:"
echo "  $SSH $PI 'journalctl -u mfd.service -n 20 --no-pager | grep -E \"ALIVE|link\"'"
