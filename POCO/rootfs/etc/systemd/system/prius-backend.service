[Unit]
Description=CyberPunk Prius headless backend (virtual twin + metrics + network API)
Documentation=file:///home/user/cyberpunk/POCO/SCRIPTS_AND_FILES.md
# timesyncd restores an approximate clock from its saved clock file the
# moment it starts (no internet needed) — ordering after it keeps early
# journal lines and metrics DB rows from being stamped 1970 (the PMIC RTC
# is not battery-persisted on this device).
After=network-online.target systemd-timesyncd.service
Wants=network-online.target systemd-timesyncd.service

[Service]
Type=simple
# ensure-venv is idempotent: fast no-op once the venv + deps are in place.
ExecStartPre=/usr/local/sbin/prius-backend ensure-venv
ExecStart=/usr/local/sbin/prius-backend run

# Resilient: the USB gateway may be absent at boot or hot-unplugged.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
