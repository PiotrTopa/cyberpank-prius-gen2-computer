[Unit]
Description=Apply Prius wifi mode (client/ap/off) from /etc/prius/wifi-mode
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
# small helper: runs with the backend on its dedicated core
Slice=prius.slice
Type=oneshot
ExecStart=/usr/local/sbin/prius-wifi apply
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
