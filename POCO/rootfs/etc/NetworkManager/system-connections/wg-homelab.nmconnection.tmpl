[connection]
id=wg-homelab
uuid=218d8c55-9f83-4dc9-b335-3a157d217908
type=wireguard
interface-name=wg-homelab

[wireguard]
private-key=${WG_PRIVATE_KEY}

[wireguard-peer.${WG_PEER_PUBLIC_KEY}]
endpoint=${WG_ENDPOINT}
persistent-keepalive=25
allowed-ips=10.200.0.0/24;192.168.0.0/24;

[ipv4]
address1=${WG_ADDRESS}
# No DNS on the tunnel: resolved would send queries through wg, which is down
# while the clock is stale (the hub drops back-dated handshakes) -> NTP cannot
# resolve -> clock never fixes. DNS lives on the LTE link (prius-wan).
method=manual
# Above Wi-Fi (600) and LTE (800): on a home LAN the connected 192.168.0.0/24
# route of wlan0 must win over the tunnel's AllowedIPs route, or replies to LAN
# clients would leave through wg (and be dropped by the hub).
route-metric=900

[ipv6]
addr-gen-mode=default
method=disabled

[proxy]
