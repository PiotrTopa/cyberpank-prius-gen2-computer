[connection]
id=prius-home-wifi
uuid=fdad36a3-2c90-475f-a900-e52db5d03b53
type=wifi
autoconnect=false
interface-name=wlan0

[wifi]
mode=infrastructure
ssid=in_the_center_of_nowhere

[wifi-security]
key-mgmt=wpa-psk
psk=${HOME_WIFI_PSK}

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=ignore

[proxy]
